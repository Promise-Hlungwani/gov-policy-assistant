# Copy this file to .env and provide credentials through your local environment.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@NEON_HOST/DB_NAME?sslmode=require
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=
GOVERNMENT_WEBSITE_URLS=["https://www.gov.za","https://www.dpsa.gov.za","https://www.sita.co.za","https://www.treasury.gov.za","https://www.justice.gov.za","https://www.dws.gov.za","https://www.gov.za/documents"]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=5
